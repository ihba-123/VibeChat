# Copy to Backend/.env and fill in. Nothing in the codebase hardcodes these.

# ---------- Core ----------

SECRET_KEY=change-me-to-a-long-random-string

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=INFO

# Public origin of the React app. Drives OAuth redirects, CORS and CSRF trust.

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database (PostgreSQL) ----------

DB_NAME=vibechat

DB_USER=postgres

DB_PASSWORD=postgres

DB_HOST=127.0.0.1

DB_PORT=5432

# Keep at 0 unless a connection pooler (pgbouncer) is in front: persistent
# connections are thread-local, and the ASGI thread pool exhausts
# PostgreSQL max_connections with them enabled.
DB_CONN_MAX_AGE=0

# ---------- Redis ----------
# One instance, three logical databases so the three workloads cannot collide.
#   DB 0 -> Django Channels (realtime)
#   DB 1 -> Django cache (presence counters, OTP rate limits)
#   DB 2 -> Celery broker + results
REDIS_URL=redis://127.0.0.1:6379
REDIS_CHANNELS_DB=0
REDIS_CACHE_DB=1
REDIS_CELERY_DB=2
# ---------- Infrastructure backends ----------
# 'redis' is the production setting for both, and what makes the cache and the
# channel layer shared across workers.
# 'locmem'/'inmemory' are a single-process fallback for running without Redis
# installed; never use them with more than one worker.
CACHE_BACKEND=redis
CHANNEL_LAYER_BACKEND=redis

# Run Celery tasks inline instead of via a broker (dev only: no worker needed).
# Leave False in production and run: celery -A System worker -l info -Q emails,default
CELERY_TASK_ALWAYS_EAGER=False

# ---------- Message encryption ----------

# Comma separated, newest key FIRST. Every key is tried when decrypting, the first

# one encrypts, so keys can be rotated without touching stored rows.

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

FERNET_KEYS=

# ---------- Media storage ----------
# 'auto' uses Cloudinary when all three credentials below are set, else local disk.
# Force with 'cloudinary' or 'local'. Local uploads land in Backend/media/ and are
# served from BACKEND_URL/media/ (development only - use a real web server or object
# store in production).
MEDIA_BACKEND=auto
# Absolute origin of this API. Used to turn a relative media path into a URL the SPA
# can load from its own origin.
BACKEND_URL=http://localhost:8000

# ---------- Cloudinary ----------

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

# Leave blank so avatar-less users return photo:null and the UI draws initials.
# Set only to assets that actually exist in your Cloudinary account.
DEFAULT_AVATAR_PUBLIC_ID=

DEFAULT_GROUP_IMAGE_PUBLIC_ID=

MAX_UPLOAD_SIZE_MB=25

# ---------- JWT ----------

ACCESS_TOKEN_MINUTES=50

REFRESH_TOKEN_DAYS=7

# Set SameSite=None + Secure=True only when the API and SPA are on different sites.

REFRESH_COOKIE_SAMESITE=Lax

REFRESH_COOKIE_SECURE=False

REFRESH_COOKIE_DOMAIN=

# ---------- Google OAuth (optional) ----------

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# ---------- Email (OTP delivery) ----------

# For local development without SMTP:

# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.gmail.com

EMAIL_PORT=587

EMAIL_HOST_USER=

EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=VibeChat <noreply@vibechat.app>

# ---------- Throttling ----------

THROTTLE_ANON=100/hour

THROTTLE_USER=2000/hour

THROTTLE_AUTH=20/hour

THROTTLE_OTP=10/hour

THROTTLE_SEARCH=120/minute

THROTTLE_UPLOAD=60/minute

PAGE_SIZE=30

# ---------- Behind a TLS-terminating proxy ----------

SECURE_PROXY_SSL_HEADER=False

USE_X_FORWARDED_HOST=False

