# Copy to Frontend/chat/.env and adjust. Vite only exposes VITE_-prefixed vars.
# Nothing in src/ hardcodes a host, port or path — it all comes from here.

# ---------- Backend ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api

# WebSocket origin. Leave blank to derive it from VITE_API_BASE_URL
# (http -> ws, https -> wss).
VITE_WS_BASE_URL=
VITE_WS_PATH=/ws/stream/

# ---------- Google sign-in ----------
VITE_GOOGLE_ENABLED=true
VITE_GOOGLE_LOGIN_PATH=/accounts/google/login/

# ---------- Branding ----------
VITE_APP_NAME=VibeChat

# ---------- Paging ----------
VITE_MESSAGE_PAGE_SIZE=30
VITE_LIST_PAGE_SIZE=30

# ---------- Caching ----------
# How long a cached list is trusted before a background refetch (ms).
VITE_STALE_TIME_MS=30000
# How long an unused cache entry is kept in memory (ms).
VITE_GC_TIME_MS=1800000
# How long the localStorage snapshot stays valid (ms).
VITE_PERSIST_MAX_AGE_MS=86400000
# Bump this to invalidate every persisted cache after a breaking data change.
VITE_CACHE_KEY=vibechat.cache.v1

# ---------- Realtime ----------
VITE_WS_RECONNECT_BASE_MS=500
VITE_WS_RECONNECT_MAX_MS=15000
VITE_WS_HEARTBEAT_MS=25000

# ---------- Composer ----------
VITE_TYPING_IDLE_MS=2500
VITE_TYPING_THROTTLE_MS=1500
VITE_SEARCH_DEBOUNCE_MS=300
VITE_MAX_UPLOAD_MB=25
VITE_MAX_MESSAGE_LENGTH=5000
